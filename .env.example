# PostgreSQL
POSTGRES_USER=cocktail
POSTGRES_PASSWORD=cocktail
POSTGRES_DB=cocktail
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://cocktail:cocktail@127.0.0.1:5432/cocktail

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_HOST=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=cocktail-images
MINIO_SECURE=false
MINIO_PUBLIC_BASE=http://127.0.0.1:9000

# Python 爬虫
CRAWL_USER_AGENT=CocktailMVP/0.1 (+local ingest)
MIXMYTH_DELAY_SECONDS=0.8
COCKTAILDB_DELAY_SECONDS=0.35
COCKTAILDB_API_KEY=1

# 向量化：api=千问 OpenAI 兼容；local=本机 BGE-M3
# EMBEDDING_API_KEY 为空时复用 IMAGE_API_KEY（百炼）
EMBEDDING_PROVIDER=api
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIM=1024
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=10

# DeepSeek（OpenAI 兼容）。真实 key 只放 .env，不要提交
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 定制特调配图。qwen=通义千问生图（qwen-image-2.1-pro）
IMAGE_PROVIDER=qwen
IMAGE_API_KEY=
IMAGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
IMAGE_MODEL=qwen-image-2.1-pro
