{
  "name": "cocktail-frontend",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "app": "pnpm --filter @cocktail/app-rn start",
    "app:ios": "pnpm --filter @cocktail/app-rn ios",
    "app:android": "pnpm --filter @cocktail/app-rn android",
    "app:web": "pnpm --filter @cocktail/app-rn web",
    "mp": "node ./apps/app-mp/scripts/build.mjs --watch",
    "mp:build": "node ./apps/app-mp/scripts/build.mjs",
    "mp:build:prod": "node ./apps/app-mp/scripts/build.mjs --prod"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
