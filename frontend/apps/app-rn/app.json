{
  "expo": {
    "name": "Cocktail",
    "slug": "cocktail-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#14110F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cocktail.app",
      "infoPlist": {
        "NSCameraUsageDescription": "用于拍摄酒瓶，识别材料并加入酒柜",
        "NSPhotoLibraryUsageDescription": "用于选择酒瓶照片，识别材料并加入酒柜",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#14110F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cocktail.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "用于选择酒瓶照片，识别材料并加入酒柜",
          "cameraPermission": "用于拍摄酒瓶，识别材料并加入酒柜"
        }
      ]
    ]
  }
}
