.login-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
  background: rgba(0, 0, 0, 0.62);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.login-dialog {
  width: 100%;
  max-width: 620rpx;
  padding: 40rpx 36rpx 32rpx;
  background: #1b1b1f;
  border: 2rpx solid #303034;
  border-radius: 28rpx;
  box-sizing: border-box;
}

.login-dialog-title {
  color: #f5f5f5;
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
}

.login-dialog-desc {
  margin-top: 16rpx;
  margin-bottom: 12rpx;
  text-align: center;
  font-size: 26rpx;
  line-height: 1.5;
  color: #a0a0aa;
}

.btn-primary {
  height: 96rpx;
  border-radius: 24rpx;
  background: #f34b2f;
  color: #f5f5f5;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0 32rpx;
}

.btn-ghost {
  height: 96rpx;
  border-radius: 24rpx;
  background: transparent;
  color: #f5f5f5;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #303034;
  padding: 0 32rpx;
}

.login-dialog-btn {
  width: 100%;
  margin-top: 16rpx;
}

.login-dialog-btn::after {
  border: none;
}

.btn-primary[disabled],
.btn-ghost[disabled] {
  opacity: 0.5;
}
