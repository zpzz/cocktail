@import "../../styles/common.wxss";

.cabinet {
  min-height: 100vh;
  padding-bottom: 160rpx;
  position: relative;
}

.toolbar {
  margin-bottom: 20rpx;
  align-items: center;
}

.add-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: #1b1b1f;
  border: 2rpx solid #303034;
  color: #f34b2f;
  font-size: 48rpx;
  line-height: 64rpx;
  text-align: center;
  font-weight: 300;
}

.search-wrap {
  background: #1b1b1f;
  border: 2rpx solid #303034;
  border-radius: 24rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  height: 80rpx;
  color: #f5f5f5;
  font-size: 28rpx;
}

.ph {
  color: #a0a0aa;
}

.cat-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.cat-chip {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #1b1b1f;
  border: 2rpx solid #303034;
  color: #a0a0aa;
  font-size: 24rpx;
}

.cat-on {
  border-color: #f34b2f;
  color: #f34b2f;
}

.list {
  max-height: calc(100vh - 420rpx);
}

.item {
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  background: #111111;
  flex-shrink: 0;
}

.thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex1 {
  flex: 1;
  min-width: 0;
}

.name {
  color: #f5f5f5;
  font-size: 30rpx;
  font-weight: 600;
}

.en,
.meta {
  font-size: 24rpx;
  margin-top: 6rpx;
}

.stock {
  margin-top: 8rpx;
  color: #f34b2f;
  font-size: 24rpx;
}

.cta-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #111111;
  border-top: 2rpx solid #303034;
}

.cta {
  width: 100%;
}

.modal {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.72);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.modal-panel {
  width: 100%;
  max-height: 88vh;
  background: #111111;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));
  overflow: hidden;
}

.modal-title {
  color: #f5f5f5;
  font-size: 36rpx;
  font-weight: 700;
}

.modal-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.close {
  color: #a0a0aa;
  font-size: 28rpx;
  padding: 12rpx 20rpx;
  background: #1b1b1f;
  border-radius: 36rpx;
}

.photo-entry {
  margin: 24rpx 0;
  padding: 24rpx;
}

.photo-icon {
  font-size: 36rpx;
}

.catalog-list,
.menu-list {
  max-height: 46vh;
  margin-bottom: 20rpx;
}

.catalog-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
}

.catalog-card {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  box-sizing: border-box;
  padding: 12rpx;
  border-radius: 20rpx;
  background: #1b1b1f;
  border: 2rpx solid #303034;
}

.catalog-card-on {
  border-color: #f34b2f;
  background: #2a1814;
}

.catalog-thumb {
  width: 100%;
  height: 140rpx;
  border-radius: 14rpx;
  background: #111111;
  display: block;
}

.catalog-thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #a0a0aa;
  font-size: 40rpx;
}

.catalog-en {
  margin-top: 10rpx;
  color: #a0a0aa;
  font-size: 20rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.catalog-name {
  margin-top: 4rpx;
  color: #f5f5f5;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.3;
  max-height: 62rpx;
  overflow: hidden;
}

.catalog-meta {
  margin-top: 6rpx;
  font-size: 18rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.catalog-check {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background: #f34b2f;
  color: #1b1b1f;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.switch-row {
  margin: 24rpx 0;
  font-size: 28rpx;
}

.menu-card {
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.badge {
  display: inline-flex;
  margin-top: 12rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.badge-full {
  color: #1b1b1f;
  background: #f34b2f;
}

.badge-partial {
  color: #f5f5f5;
  background: #5a4038;
}
