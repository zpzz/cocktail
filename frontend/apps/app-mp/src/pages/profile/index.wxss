@import "../../styles/common.wxss";

.profile {
  padding-top: 24rpx;
}

.identity {
  margin-bottom: 56rpx;
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background: #303034;
  border: 2rpx solid rgba(243, 75, 47, 0.33);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-text {
  color: #f34b2f;
  font-size: 44rpx;
  font-weight: 700;
}

.identity-name {
  color: #f5f5f5;
  font-size: 34rpx;
  font-weight: 600;
}

.edit {
  margin-bottom: 40rpx;
}

.edit-hint {
  margin-bottom: 20rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.edit-avatar-btn {
  width: 148rpx;
  height: 148rpx;
  margin: 0 auto 24rpx;
  padding: 0;
  border-radius: 74rpx;
  overflow: hidden;
  background: #303034;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-avatar-btn::after {
  border: none;
}

.edit-avatar-img {
  width: 148rpx;
  height: 148rpx;
}

.flex1 {
  flex: 1;
}

.menu-entry {
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.menu-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: #111111;
  color: #f34b2f;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-title {
  color: #f5f5f5;
  font-size: 32rpx;
  font-weight: 600;
}

.menu-sub {
  font-size: 24rpx;
  margin-top: 4rpx;
}

.chevron {
  font-size: 40rpx;
}

.login,
.logout {
  margin-top: 56rpx;
}
