<view class="page profile">
  <view class="identity card row gap-md" bindtap="startEdit">
    <view class="avatar">
      <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
      <text wx:else class="avatar-text">{{initial}}</text>
    </view>
    <view class="identity-body">
      <view class="identity-name">{{displayName}}</view>
      <view class="muted">{{subtitle}}</view>
    </view>
  </view>

  <view wx:if="{{loggedIn && editing}}" class="edit card">
    <view class="section-label">完善资料</view>
    <view class="muted edit-hint">点头像可选微信头像；昵称输入时键盘上方可一键填入微信昵称。</view>
    <button
      class="edit-avatar-btn"
      open-type="chooseAvatar"
      bindchooseavatar="onChooseAvatar"
    >
      <image
        wx:if="{{draftAvatar || avatarUrl}}"
        class="edit-avatar-img"
        src="{{draftAvatar || avatarUrl}}"
        mode="aspectFill"
      />
      <text wx:else class="muted">选择微信头像</text>
    </button>
    <input
      class="input"
      type="nickname"
      placeholder="填写微信昵称"
      value="{{draftNickname}}"
      bindinput="onNicknameInput"
    />
    <button
      class="btn-primary"
      loading="{{busy}}"
      disabled="{{busy}}"
      bindtap="saveProfile"
    >
      保存
    </button>
  </view>

  <view class="section-label">收藏</view>

  <view class="menu-entry card row gap-md" bindtap="goMenus">
    <view class="menu-icon">酒</view>
    <view class="flex1">
      <view class="menu-title">酒单</view>
      <view class="muted menu-sub">用库存生成并保存的配方单</view>
    </view>
    <text class="chevron muted">›</text>
  </view>

  <view class="menu-entry card row gap-md" bindtap="goCustoms">
    <view class="menu-icon">特</view>
    <view class="flex1">
      <view class="menu-title">特调</view>
      <view class="muted menu-sub">工作台生成的专属配方卡片</view>
    </view>
    <text class="chevron muted">›</text>
  </view>

  <button
    wx:if="{{!loggedIn}}"
    class="btn-primary login"
    loading="{{busy}}"
    disabled="{{busy}}"
    bindtap="onWechatLogin"
  >
    微信登录
  </button>

  <button
    wx:else
    class="btn-danger logout"
    loading="{{busy}}"
    disabled="{{busy}}"
    bindtap="onLogout"
  >
    退出登录
  </button>

  <login-prompt />
</view>
