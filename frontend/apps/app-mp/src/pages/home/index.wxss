@import "../../styles/common.wxss";

.home {
  min-height: 100vh;
  background: #111111;
  padding-bottom: 40rpx;
}

.header {
  padding: 16rpx 32rpx 24rpx;
  box-sizing: content-box;
}

.logo {
  width: 100rpx;
  height: 100rpx;
  border-radius: 28rpx;
}

.brand-cn {
  color: #f5f5f5;
  font-size: 36rpx;
  font-weight: 700;
}

.brand-en {
  color: #a0a0aa;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  font-weight: 600;
}

.body {
  padding: 0 32rpx;
}

.hero {
  position: relative;
  overflow: hidden;
  min-height: 280rpx;
  margin-bottom: 24rpx;
}

.hero-glow {
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: #f34b2f;
  opacity: 0.12;
}

.hero-body {
  position: relative;
  z-index: 1;
}

.hero-title {
  color: #f5f5f5;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.35;
  white-space: pre-line;
}

.hero-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.hero-cta {
  display: inline-flex;
  margin-top: 24rpx;
  background: #f34b2f;
  color: #f5f5f5;
  font-size: 26rpx;
  font-weight: 700;
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
}

.section-head {
  margin: 8rpx 0 16rpx;
}

.section-title {
  color: #f5f5f5;
  font-size: 32rpx;
  font-weight: 700;
}

.section-more {
  font-size: 26rpx;
}

.reco {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 28rpx;
  min-height: 220rpx;
  margin-bottom: 24rpx;
  padding: 28rpx;
}

.reco-thumb {
  width: 180rpx;
  height: 180rpx;
  border-radius: 28rpx;
  background: #111111;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.reco-img {
  width: 100%;
  height: 100%;
}

.reco-body {
  flex: 1;
  min-width: 0;
}

.reco-name {
  color: #f5f5f5;
  font-size: 32rpx;
  font-weight: 700;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reco-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.quick-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.quick-card {
  width: calc(50% - 10rpx);
  min-height: 160rpx;
  padding: 28rpx;
  box-sizing: border-box;
}

.quick-muted {
  opacity: 0.55;
}

.quick-icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 16rpx;
}

.quick-title {
  color: #f5f5f5;
  font-size: 28rpx;
  font-weight: 700;
}

.quick-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
}
