@import "../../styles/common.wxss";

.chat {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #111111;
}

.list {
  flex: 1;
  height: 0;
  padding: 24rpx 32rpx;
}

.msg {
  margin-bottom: 28rpx;
}

.msg-user {
  display: flex;
  justify-content: flex-end;
}

.msg-bot {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
  max-width: 96%;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.bubble {
  max-width: 88%;
  padding: 24rpx;
  border-radius: 32rpx;
}

.bubble-user {
  background: #f34b2f;
  border-top-right-radius: 8rpx;
}

.bubble-bot {
  flex: 1;
  background: #1b1b1f;
  border: 2rpx solid #303034;
  border-top-left-radius: 8rpx;
}

.body {
  color: #f5f5f5;
  font-size: 30rpx;
  line-height: 1.5;
  white-space: pre-wrap;
}

.status {
  font-size: 28rpx;
}

.sources {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
  margin-bottom: 12rpx;
}

.source-label {
  font-size: 24rpx;
}

.source-chip {
  color: #c9a227;
  font-size: 24rpx;
  background: #111111;
  border-radius: 16rpx;
  padding: 8rpx 16rpx;
}

.photo {
  width: 100%;
  max-width: 440rpx;
  height: 320rpx;
  border-radius: 24rpx;
  background: #111111;
  margin-bottom: 12rpx;
}

.composer {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #303034;
  background: #1b1b1f;
}

.composer-input {
  flex: 1;
  min-height: 88rpx;
  border-radius: 44rpx;
  padding: 0 32rpx;
  color: #f5f5f5;
  background: #111111;
  border: 2rpx solid #303034;
  font-size: 28rpx;
}

.ph {
  color: #a0a0aa;
}

.send {
  width: 120rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: #f34b2f;
  color: #f5f5f5;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.send-off {
  opacity: 0.45;
}
