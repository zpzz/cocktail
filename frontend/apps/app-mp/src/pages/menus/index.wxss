@import "../../styles/common.wxss";

.menus {
  padding-top: 24rpx;
}

.header {
  margin-bottom: 24rpx;
}

.item {
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.flex1 {
  flex: 1;
  min-width: 0;
}

.item-title {
  color: #f5f5f5;
  font-size: 32rpx;
  font-weight: 600;
}

.meta {
  font-size: 24rpx;
  margin-top: 8rpx;
}

.en {
  font-size: 24rpx;
  margin-top: 4rpx;
}

.del {
  color: #e07070;
  font-size: 26rpx;
  margin-right: 12rpx;
  padding: 8rpx;
}

.chevron {
  font-size: 36rpx;
}

.close {
  color: #a0a0aa;
  font-size: 28rpx;
  padding: 12rpx 20rpx;
  background: #1b1b1f;
  border-radius: 36rpx;
}

.menu-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.thumb {
  width: 144rpx;
  height: 144rpx;
  border-radius: 20rpx;
  background: #303034;
  flex-shrink: 0;
}

.thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge {
  display: inline-flex;
  margin-top: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.badge-full {
  color: #1b1b1f;
  background: #f34b2f;
}

.badge-partial {
  color: #f5f5f5;
  background: #5a4038;
}

.block {
  margin-top: 20rpx;
  padding-top: 8rpx;
}

.block-title {
  color: #f34b2f;
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.block-text {
  font-size: 26rpx;
  line-height: 1.55;
}
