@import "../../styles/common.wxss";

.customs {
  padding-top: 24rpx;
}

.header {
  margin-bottom: 24rpx;
}

.item {
  margin-bottom: 20rpx;
  padding: 24rpx;
}

.thumb {
  width: 144rpx;
  height: 144rpx;
  border-radius: 24rpx;
  background: #111111;
  flex-shrink: 0;
}

.thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex1 {
  flex: 1;
  min-width: 0;
}

.item-title {
  color: #f5f5f5;
  font-size: 32rpx;
  font-weight: 700;
}

.en {
  font-size: 24rpx;
  margin-top: 4rpx;
}

.meta {
  font-size: 24rpx;
  margin-top: 12rpx;
}

.flavor {
  font-size: 24rpx;
  margin-top: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.del {
  color: #e07070;
  font-size: 26rpx;
  padding: 8rpx;
}
