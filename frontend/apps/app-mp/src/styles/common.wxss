.page {
  min-height: 100vh;
  background: #111111;
  color: #f5f5f5;
  padding: 0 40rpx 40rpx;
}

.kicker {
  color: #f34b2f;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.title {
  color: #f5f5f5;
  font-size: 44rpx;
  font-weight: 700;
  margin-top: 8rpx;
}

.subtitle,
.muted {
  color: #a0a0aa;
  font-size: 26rpx;
  line-height: 1.45;
}

.card {
  background: #1b1b1f;
  border: 2rpx solid #303034;
  border-radius: 28rpx;
  padding: 28rpx;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.row-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.gap-sm {
  gap: 16rpx;
}

.gap-md {
  gap: 24rpx;
}

.input {
  height: 96rpx;
  border-radius: 24rpx;
  padding: 0 28rpx;
  color: #f5f5f5;
  background: #1b1b1f;
  border: 2rpx solid #303034;
  font-size: 30rpx;
  margin-bottom: 24rpx;
}

.btn-primary {
  height: 96rpx;
  border-radius: 24rpx;
  background: #f34b2f;
  color: #f5f5f5;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0 32rpx;
}

.btn-primary[disabled],
.btn-primary.disabled {
  opacity: 0.5;
}

.btn-ghost {
  height: 96rpx;
  border-radius: 24rpx;
  background: transparent;
  color: #f5f5f5;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #303034;
  padding: 0 32rpx;
}

.btn-danger {
  height: 96rpx;
  border-radius: 24rpx;
  background: transparent;
  color: #e07070;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #5a4038;
}

.empty {
  color: #a0a0aa;
  text-align: center;
  margin-top: 96rpx;
  font-size: 28rpx;
}

.error {
  color: #f34b2f;
  font-size: 28rpx;
  margin: 12rpx 0;
}

.tag {
  display: inline-flex;
  background: rgba(243, 75, 47, 0.2);
  color: #f34b2f;
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.section-label {
  color: #a0a0aa;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  margin-bottom: 20rpx;
}

.loader {
  padding: 80rpx 0;
  text-align: center;
  color: #a0a0aa;
  font-size: 28rpx;
}
